# Cloudflare Workers static assets — cache headers.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Only applies to static asset responses (this is a Workers static-assets
# site, no Worker script, so that's everything). Rules are additive — a
# request matching multiple patterns gets all of them, and a header set by
# more than one matching rule gets its values comma-joined — so each path
# below is covered by exactly one rule to avoid that. HTML (/, /en/) matches
# none of these and keeps Cloudflare's default revalidating behavior.

# Hashed build output (Vite/Astro content-hashed filenames) — safe to cache
# forever, a content change always ships under a new filename.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font files (src/styles/global.css). Filenames carry a hash of
# the file's content (name.<sha256:8>.woff2), so replacing a font means a new
# filename and immutable caching is safe. Rename when you swap a file.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Case-study images — not hashed, can be swapped in place, so a shorter
# cache with revalidation instead of `immutable`.
/work/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-image-*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
