---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  // Role and place up front: the title is the strongest on-page signal for
  // "developer in Medellín" searches. Google truncates by pixel width (~600px),
  // which this fits; keep additions short.
  title = "Victor Olave · Senior Fullstack Developer · Medellín, Colombia",
  // ≤155 characters, or Google truncates it in results.
  description = "Senior fullstack developer in Envigado, Medellín area, Colombia. Nine years of React, TypeScript and Node.js, now building AI products: LLMs, MCP, RAG.",
} = Astro.props;

// Absolute URLs for og:/twitter: — relative paths are ignored by every social
// crawler. Astro.site comes from `site` in astro.config.mjs; the fallback only
// matters in a build that has lost it, and would bake in the dev origin.
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL("/og-image.jpg", origin).href;
const home = new URL("/", origin).href;

// Structured data: who this page is about, where he works and what he knows.
// Every value is backed by the page or the CV — do not add claims here that the
// visible content does not make. `areaServed` is not a Person property, so the
// Medellín area is expressed through the occupation's location instead.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${home}#profile`,
      url: canonical,
      name: title,
      inLanguage: "en",
      mainEntity: { "@id": `${home}#person` },
    },
    {
      "@type": "Person",
      "@id": `${home}#person`,
      name: "Victor Olave",
      url: home,
      jobTitle: "Senior Fullstack Developer",
      description,
      email: "mailto:victorolave1131@gmail.com",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Envigado",
        addressRegion: "Antioquia",
        addressCountry: "CO",
      },
      hasOccupation: {
        "@type": "Occupation",
        name: "Senior Fullstack Developer",
        occupationLocation: [
          { "@type": "City", name: "Medellín" },
          { "@type": "City", name: "Envigado" },
        ],
      },
      knowsAbout: [
        "React",
        "TypeScript",
        "Next.js",
        "Node.js",
        "NestJS",
        "PostgreSQL",
        "LLM integration",
        "AI agents",
        "Model Context Protocol",
        "Retrieval-augmented generation",
      ],
      knowsLanguage: ["es", "en"],
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Corporación Universitaria Comfacauca",
      },
      sameAs: ["https://github.com/victorolave", "https://www.linkedin.com/in/victorolave"],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Mark JS available before first paint so we can hide reveal-targets via CSS
      // without flickering on no-JS / slow-JS environments.
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1A1D24" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,30..100;1,9..144,300..700,30..100&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap"
    />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Victor Olave · Senior Fullstack Developer" />
    <meta property="og:site_name" content="Victor Olave" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style is:global>
      :root {
        --font-fraunces: "Fraunces";
        --font-inter: "Inter";
        --font-jetbrains-mono: "JetBrains Mono";
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      import { initKineticEditorial } from "../scripts/motion";
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initKineticEditorial);
      } else {
        initKineticEditorial();
      }
    </script>
  </body>
</html>
