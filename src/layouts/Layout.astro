---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Victor Olave · Senior Fullstack Developer",
  description = "Nine years building the systems behind useful products with React, TypeScript and Node.js, now focused on AI-powered product engineering: LLMs, agents with MCP, and RAG.",
} = Astro.props;

// Absolute URLs for og:/twitter: — relative paths are ignored by every social
// crawler. Astro.site comes from `site` in astro.config.mjs; without it the
// tags fall back to the deployed origin at request time.
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL("/og-image.jpg", origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Mark JS available before first paint so we can hide reveal-targets via CSS
      // without flickering on no-JS / slow-JS environments.
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1A1D24" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,30..100;1,9..144,300..700,30..100&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap"
    />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Victor Olave · Senior Fullstack Developer" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <style is:global>
      :root {
        --font-fraunces: "Fraunces";
        --font-inter: "Inter";
        --font-jetbrains-mono: "JetBrains Mono";
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      import { initKineticEditorial } from "../scripts/motion";
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initKineticEditorial);
      } else {
        initKineticEditorial();
      }
    </script>
  </body>
</html>
