---
const year = new Date().getFullYear();
const email = "victorolave1131@gmail.com";

const nav = [
  { id: "work", label: "Work" },
  { id: "about", label: "About" },
  { id: "contact", label: "Contact" },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/victorolave",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/victorolave",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
];

const linkClass =
  "font-mono text-[11px] uppercase text-[var(--color-fg-secondary)] transition-colors duration-200 hover:text-[var(--color-rose)]";
---

<footer
  class="relative border-t border-[var(--color-border)] bg-[var(--color-bg-deep)]"
>
  <div class="mx-auto max-w-[1600px] px-4 py-12 md:px-12 md:py-16">
    <!-- ============================================================
         MOBILE — blueprint "index sheet": one primary CTA row, then
         tappable directory rows, then a quiet baseline. Each row is a
         comfortable touch target with a clear ↗ affordance.
         ============================================================ -->
    <div class="md:hidden">
      <!-- Wordmark -->
      <a href="#hero" data-cursor="Top" class="group inline-block">
        <span
          class="fraunces font-light leading-[0.9] tracking-[-0.04em] text-[var(--color-fg-primary)]"
          style="font-size: clamp(44px, 13vw, 60px);"
        >
          Victor <em class="fraunces-italic">Olave</em><span
            class="text-[var(--color-rose)]">.</span
          >
        </span>
      </a>

      <!-- Primary CTA: email -->
      <a
        href={`mailto:${email}`}
        data-cursor="Send"
        class="footer-email group mt-8 flex items-center justify-between gap-4 border-y border-[var(--color-border)] py-5"
      >
        <span class="flex flex-col gap-1.5">
          <span class="eyebrow">Let's talk</span>
          <span
            class="fraunces-italic font-light text-[var(--color-fg-primary)] transition-colors duration-300 group-hover:text-[var(--color-rose)]"
            style="font-size: clamp(22px, 6vw, 28px); letter-spacing: -0.01em;"
          >
            {email}
          </span>
        </span>
        <span
          class="shrink-0 text-xl text-[var(--color-rose)] transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
          aria-hidden="true"
        >
          ↗
        </span>
      </a>

      <!-- Directory: menu -->
      <nav class="mt-9">
        <span class="sheet-mark">MENU</span>
        <div class="mt-3 flex flex-col">
          {nav.map((l) => (
            <a
              href={`#${l.id}`}
              class="group flex items-center justify-between border-b border-[var(--color-border)] py-3.5"
            >
              <span
                class="font-mono text-xs uppercase text-[var(--color-fg-secondary)] transition-colors duration-200 group-hover:text-[var(--color-rose)]"
                style="letter-spacing: 0.22em;"
              >
                {l.label}
              </span>
              <span
                class="text-[var(--color-fg-tertiary)] transition-all duration-200 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-[var(--color-rose)]"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))}
        </div>
      </nav>

      <!-- Directory: socials -->
      <div class="mt-9">
        <span class="sheet-mark">ELSEWHERE</span>
        <div class="mt-3 flex flex-col">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="View"
              class="group flex items-center justify-between border-b border-[var(--color-border)] py-3.5"
            >
              <span class="flex items-center gap-3">
                <svg
                  viewBox="0 0 24 24"
                  class="h-[18px] w-[18px] text-[var(--color-fg-tertiary)] transition-colors duration-200 group-hover:text-[var(--color-rose)]"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={s.path} />
                </svg>
                <span
                  class="font-mono text-xs uppercase text-[var(--color-fg-secondary)] transition-colors duration-200 group-hover:text-[var(--color-rose)]"
                  style="letter-spacing: 0.22em;"
                >
                  {s.label}
                </span>
              </span>
              <span
                class="text-[var(--color-fg-tertiary)] transition-all duration-200 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-[var(--color-rose)]"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Baseline meta -->
      <div
        class="mt-10 flex flex-col gap-1 font-mono text-[11px] uppercase text-[var(--color-fg-quaternary)]"
        style="letter-spacing: 0.22em;"
      >
        <span>© {year} Victor Olave</span>
        <span class="text-[var(--color-fg-tertiary)]">Envigado, Colombia</span>
      </div>
    </div>

    <!-- ============================================================
         DESKTOP — unchanged editorial layout.
         ============================================================ -->
    <div class="hidden md:block">
      <!-- Top: wordmark + email CTA -->
      <div
        class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
      >
        <a href="#hero" data-cursor="Top" class="group inline-block">
          <span
            class="fraunces font-light leading-[0.9] tracking-[-0.04em] text-[var(--color-fg-primary)]"
            style="font-size: clamp(40px, 7vw, 84px);"
          >
            Victor <em class="fraunces-italic">Olave</em><span
              class="text-[var(--color-rose)]">.</span
            >
          </span>
        </a>

        <a
          href={`mailto:${email}`}
          data-cursor="Send"
          data-magnetic="0.4"
          class="footer-email group inline-flex items-center gap-2 fraunces-italic font-light text-[var(--color-fg-secondary)] transition-colors duration-300 hover:text-[var(--color-rose)]"
          style="font-size: clamp(19px, 2vw, 26px); letter-spacing: -0.01em;"
        >
          {email}
          <span
            class="text-[0.7em] transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      </div>

      <!-- Bottom: nav · meta · socials -->
      <div
        class="mt-14 flex flex-row items-center justify-between border-t border-[var(--color-border)] pt-8"
      >
        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {nav.map((l) => (
            <a href={`#${l.id}`} class={linkClass} style="letter-spacing: 0.22em;">
              {l.label}
            </a>
          ))}
        </nav>

        <div
          class="flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-[11px] uppercase text-[var(--color-fg-quaternary)]"
          style="letter-spacing: 0.22em;"
        >
          <span>© {year} Victor Olave</span>
          <span aria-hidden="true">·</span>
          <span class="text-[var(--color-fg-tertiary)]">Envigado, Colombia</span>
        </div>

        <div class="flex items-center gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="View"
              aria-label={s.label}
              class="inline-flex h-11 w-11 items-center justify-center -m-1 text-[var(--color-fg-secondary)] transition-colors duration-200 hover:text-[var(--color-rose)]"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-[18px] w-[18px]"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={s.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
