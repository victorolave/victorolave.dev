---
const lines = [
  { method: "POST /v1/route", status: "200 OK", time: "12ms", color: "#6FA887" },
  { method: "GET /v1/health", status: "200 OK", time: "3ms", color: "#6FA887" },
  { method: "GET /v1/users", status: "429 limited", time: "1ms", color: "#C9A063" },
  { method: "POST /v1/auth", status: "200 OK", time: "8ms", color: "#6FA887" },
  { method: "circuit.open", status: "upstream-3", time: null, color: "#B5616A" },
  { method: "POST /v1/route", status: "200 OK", time: "14ms", color: "#6FA887" },
];
---

<div
  class="relative h-full w-full overflow-hidden px-4 py-[14px] font-mono"
  style="background: linear-gradient(180deg, #161922 0%, #0F1218 100%); font-size: 9px; line-height: 1.55; color: var(--color-fg-secondary);"
>
  <div class="mb-2 flex gap-1">
    <span class="h-[7px] w-[7px] rounded-full bg-[var(--color-border-strong)]"></span>
    <span class="h-[7px] w-[7px] rounded-full bg-[var(--color-border-strong)]"></span>
    <span class="h-[7px] w-[7px] rounded-full bg-[var(--color-border-strong)]"></span>
    <span class="ml-auto text-[8px] text-[var(--color-fg-tertiary)]">api-gw · production</span>
  </div>
  {
    lines.map((l) => (
      <div style={`color:${l.color}`}>
        ›
        <span class="text-[var(--color-fg-secondary)]"> {l.method}</span>
        <span class="text-[var(--color-fg-tertiary)]"> {l.status}</span>
        {l.time && <span class="text-[var(--color-fg-quaternary)]"> · {l.time}</span>}
      </div>
    ))
  }
  <div class="absolute inset-x-4 bottom-[14px] flex gap-3 text-[8px] text-[var(--color-fg-tertiary)]">
    <span><span class="text-[var(--color-rose)]">●</span> 2.4k req/s</span>
    <span>p99: 18ms</span>
    <span class="ml-auto text-[#6FA887]">healthy</span>
  </div>
</div>
