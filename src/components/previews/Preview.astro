---
// Project preview. Two modes, no third:
//   · image  — a real screenshot of the live product (public/work/*.webp)
//   · none   — a typographic plate with the project's own name and stack
// There is deliberately no illustrated "mock dashboard" mode: a fabricated UI
// implies a product that does not exist.
import { t } from "../../i18n";
import type { Locale } from "../../i18n";

interface Props {
  image: string | null;
  title: string;
  stack?: readonly string[];
  /**
   * How the screenshot meets its box.
   *  · "cover"   — fills it, cropping whatever does not fit. Right for the
   *                masonry, where the tiles read as texture.
   *  · "contain" — the whole page stays visible, letterboxed. Right for a case
   *                study, where the screenshot IS the evidence: cropping half
   *                of it away defeats the point of showing it.
   */
  fit?: "cover" | "contain";
  /** Overrides the generic alt. Pass the shot's caption so a screen reader
   *  gets what the surface shows, not just the product name. */
  alt?: string;
  locale: Locale;
}

const { image, title, stack = [], fit = "cover", alt, locale } = Astro.props;
const dict = t(locale);
---

{
  image ? (
    <img
      src={image}
      alt={alt ?? dict.a11y.screenshotAlt(title)}
      class:list={[
        "h-full w-full",
        fit === "contain" ? "object-contain object-center" : "object-cover object-top",
      ]}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="flex h-full w-full flex-col justify-between bg-[var(--color-bg-base)] p-[14px]">
      <span
        class="text-[7px] uppercase text-[var(--color-fg-tertiary)]"
        style="letter-spacing: 0.18em;"
      >
        {dict.work.sourceAvailable}
      </span>

      <span
        class="fraunces font-light leading-[1.1] tracking-[-0.03em] text-[var(--color-fg-primary)]"
        style="font-size: clamp(15px, 2.2vw, 22px);"
      >
        {title}
        <em class="fraunces-italic text-[var(--color-rose)]">.</em>
      </span>

      <ul class="flex flex-wrap gap-x-2 gap-y-1">
        {stack.slice(0, 4).map((s) => (
          <li
            class="font-mono text-[7px] uppercase text-[var(--color-fg-tertiary)]"
            style="letter-spacing: 0.14em;"
          >
            {s}
          </li>
        ))}
      </ul>
    </div>
  )
}
