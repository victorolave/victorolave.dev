---
const gutter = Array.from({ length: 14 }, (_, i) => i + 1);
---

<div class="relative flex h-full w-full overflow-hidden bg-[#161922]">
  <div
    class="w-9 border-r border-[var(--color-border)] bg-[var(--color-bg-deep)] px-2 py-3 font-mono"
    style="font-size: 8px; color: var(--color-fg-quaternary); line-height: 1.7;"
  >
    {gutter.map((n) => <div>{n}</div>)}
  </div>
  <div
    class="flex-1 px-[14px] py-3 font-mono"
    style="font-size: 9px; line-height: 1.7;"
  >
    <div>
      <span style="color:#7B96B8">export const</span>
      <span class="text-[var(--color-fg-primary)]"> tokens </span>
      <span class="text-[var(--color-fg-secondary)]">{"= {"}</span>
    </div>
    <div class="pl-[14px]">
      <span class="text-[var(--color-rose)]">color</span>
      <span class="text-[var(--color-fg-secondary)]">{": {"}</span>
    </div>
    <div class="pl-7">
      <span class="text-[var(--color-fg-secondary)]">rose: </span>
      <span style="color:#C9A063">'#C04970'</span>
      <span class="text-[var(--color-fg-secondary)]">,</span>
    </div>
    <div class="pl-7">
      <span class="text-[var(--color-fg-secondary)]">slate: </span>
      <span style="color:#C9A063">'#1A1D24'</span>
      <span class="text-[var(--color-fg-secondary)]">,</span>
    </div>
    <div class="pl-7">
      <span class="text-[var(--color-fg-secondary)]">cream: </span>
      <span style="color:#C9A063">'#E8E4DD'</span>
    </div>
    <div class="pl-[14px]">
      <span class="text-[var(--color-fg-secondary)]">{"}"}</span>,
    </div>
    <div class="pl-[14px]">
      <span class="text-[var(--color-rose)]">radii</span>
      <span class="text-[var(--color-fg-secondary)]">: [</span>
      <span style="color:#7B96B8">2</span>, <span style="color:#7B96B8">3</span>,
      <span style="color:#7B96B8">6</span>
      <span class="text-[var(--color-fg-secondary)]">],</span>
    </div>
    <div class="pl-[14px]">
      <span class="text-[var(--color-rose)]">type</span>
      <span class="text-[var(--color-fg-secondary)]">: typeScale(</span>
      <span style="color:#7B96B8">1.25</span>
      <span class="text-[var(--color-fg-secondary)]">),</span>
    </div>
    <div>
      <span class="text-[var(--color-fg-secondary)]">{"}"}</span>
    </div>
    <div class="mt-1 text-[var(--color-fg-tertiary)]">// generated 12 typed CSS vars</div>
  </div>
</div>
