---
// Experience — the recruiter-facing receipts: employment history + education,
// presented as a blueprint "index sheet" (rose square markers, mono dates).
// Two-column on desktop like About: left states the thesis, right lists the
// roles. A downloadable CV sits in the left column for fast hiring scans.
// Data validated against "Victor Olave — 2026" CV (public/victor-olave-cv-2026.pdf).
//
// Role text is translated via dict.experience.jobs (keyed by a stable id
// below). org/period/current and city proper nouns stay as component data.
// UI phrases embedded in location/note ("Remote", "Full-time → part-time",
// "Concurrent") are sourced from the dictionary (dict.experience.remote /
// noteFullTimeToPartTime / noteConcurrent) so nothing English leaks into ES;
// company names in `note` stay literal (not translatable content).
import { t } from "../i18n";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const cvHref = "/victor-olave-cv-2026.pdf";

const employment = [
  {
    id: "leanTech" as const,
    org: "Lean Tech",
    location: "Medellín",
    period: `Sep 2022 – ${dict.experience.present}`,
    note: null,
    current: true,
  },
  {
    id: "izeven" as const,
    org: "iZeven",
    location: "Medellín",
    period: "Jun 2021 – Jul 2023",
    note: dict.experience.noteFullTimeToPartTime,
    current: false,
  },
  {
    id: "freelance" as const,
    org: "Independent",
    location: dict.experience.remote,
    period: "2021 – 2022",
    note: `${dict.experience.noteConcurrent} · SYP Solutions, Comunix S.A.S., CEOTIC`,
    current: false,
  },
  {
    id: "securitic" as const,
    org: "Securitic",
    location: "Popayán",
    period: "May 2020 – May 2021",
    note: null,
    current: false,
  },
  {
    id: "creazion" as const,
    org: "Creazion",
    location: "Popayán",
    period: "Sep 2019 – May 2020",
    note: null,
    current: false,
  },
];

const education = {
  org: "Corporación Universitaria Comfacauca",
  period: "Jan 2017 – Jan 2022",
};
---

<section id="experience" class="relative border-t border-[var(--color-border)] bg-[var(--color-bg-deep)]">
  <div
    class="relative mx-auto max-w-[1600px] px-4 pt-12 pb-20 md:px-12 md:pt-16 md:pb-32"
    data-reveal
  >
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,360px)_1fr] md:gap-24">
      <!-- LEFT: thesis + availability + CV -->
      <div class="flex flex-col md:sticky md:top-28 md:self-start" data-reveal-child>
        <div class="eyebrow mb-8">{dict.experience.eyebrow}</div>

        <h3
          class="fraunces font-light leading-[0.95] tracking-[-0.04em] text-[var(--color-fg-primary)]"
          style="font-size: clamp(40px, 5vw, 72px);"
        >
          {dict.experience.headingPre} <span class="fraunces-italic text-[var(--color-rose)]">{dict.experience.headingItalic}</span>.
        </h3>

        <!-- Availability -->
        <div class="mt-8 inline-flex items-center gap-2.5 self-start">
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-success)] opacity-60"
              aria-hidden="true"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-success)]"></span>
          </span>
          <span
            class="font-mono text-[11px] uppercase text-[var(--color-fg-secondary)]"
            style="letter-spacing: 0.22em;"
          >
            {dict.experience.available}
          </span>
        </div>

        <!-- Download CV -->
        <a
          href={cvHref}
          download
          hreflang="en"
          type="application/pdf"
          data-cursor={dict.cursor.download}
          data-magnetic="0.35"
          class="group mt-7 inline-flex items-center gap-3 self-start py-2.5 -my-2.5 font-mono text-[12px] font-medium uppercase tracking-[0.2em] text-[var(--color-fg-primary)] transition-colors duration-200 hover:text-[var(--color-rose)]"
        >
          {dict.experience.cvLabel}
          <span
            class="text-[var(--color-rose)] transition-transform duration-200 group-hover:translate-y-0.5"
            aria-hidden="true">↓</span>
        </a>
      </div>

      <!-- RIGHT: role list -->
      <ol class="flex flex-col">
        {
          employment.map((job) => (
            <li
              class="group grid grid-cols-1 gap-x-8 gap-y-1.5 border-t border-[var(--color-border)] py-6 md:grid-cols-[1fr_auto] md:items-baseline"
              data-reveal-child
            >
              <div>
                <div class="flex items-baseline gap-3">
                  <span
                    class="mt-[2px] h-[7px] w-[7px] shrink-0 translate-y-[7px] bg-[var(--color-rose)]"
                    aria-hidden="true"
                  />
                  <h4
                    class="fraunces font-light leading-tight text-[var(--color-fg-primary)]"
                    style="font-size: clamp(21px, 2.4vw, 28px);"
                  >
                    {dict.experience.jobs[job.id]}
                  </h4>
                </div>
                <p class="mt-1.5 pl-[19px] text-[16px] text-[var(--color-fg-secondary)]">
                  {job.org}
                  <span class="text-[var(--color-fg-tertiary)]"> · {job.location}</span>
                </p>
                {job.note && (
                  <p
                    class="mt-1 pl-[19px] font-mono text-[11px] uppercase text-[var(--color-fg-quaternary)]"
                    style="letter-spacing: 0.14em;"
                  >
                    {job.note}
                  </p>
                )}
              </div>

              <span
                class="pl-[19px] font-mono text-[11px] uppercase text-[var(--color-fg-tertiary)] md:pl-0 md:text-right"
                style="letter-spacing: 0.18em;"
              >
                {job.period}
                {job.current && (
                  <span class="ml-2 text-[var(--color-rose)]">· {dict.experience.now}</span>
                )}
              </span>
            </li>
          ))
        }

        <!-- Education — same index-sheet rhythm as the roles, one rung quieter. -->
        <li
          class="grid grid-cols-1 gap-x-8 gap-y-1.5 border-t border-[var(--color-border)] py-6 md:grid-cols-[1fr_auto] md:items-baseline"
          data-reveal-child
        >
          <div>
            <div class="flex items-baseline gap-3">
              <span
                class="mt-[2px] h-[7px] w-[7px] shrink-0 translate-y-[7px] border border-[var(--color-rose)]"
                aria-hidden="true"
              />
              <h4
                class="fraunces font-light leading-tight text-[var(--color-fg-primary)]"
                style="font-size: clamp(19px, 2.1vw, 24px);"
              >
                {dict.experience.educationDegree}
              </h4>
            </div>
            <p class="mt-1.5 pl-[19px] text-[16px] text-[var(--color-fg-secondary)]">
              {education.org}
            </p>
          </div>

          <span
            class="pl-[19px] font-mono text-[11px] uppercase text-[var(--color-fg-tertiary)] md:pl-0 md:text-right"
            style="letter-spacing: 0.18em;"
          >
            {education.period}
          </span>
        </li>

        <!-- Closing note: the list is curated; total experience predates it. -->
        <li class="border-t border-[var(--color-border)] pt-6" data-reveal-child>
          <p
            class="font-mono text-[11px] uppercase text-[var(--color-fg-tertiary)]"
            style="letter-spacing: 0.18em;"
          >
            <span class="text-[var(--color-rose)]">+</span>
            {dict.experience.closingNote}
          </p>
        </li>
      </ol>
    </div>
  </div>
</section>
