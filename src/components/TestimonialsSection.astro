---
// Real endorsements only. This file used to carry six invented people at
// invented companies; they are gone. The list now comes from TESTIMONIALS, the
// same source the featured case reads, so a wording fix lands in both places.
import { TESTIMONIALS, quoteOf } from "../data/projects";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Initials are derived, never stored — one less field to drift out of sync
// with the name it is supposed to abbreviate.
const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => [...w][0] ?? "")
    .join("")
    .toUpperCase();

const items = TESTIMONIALS;

// The grid follows the real count instead of assuming three. With two
// endorsements a three-column track would leave a hole that reads as "one is
// missing"; two centred columns read as "these are the two."
const cols = Math.min(items.length, 3);
const gridCols = cols >= 3 ? "sm:grid-cols-2 md:grid-cols-3" : cols === 2 ? "sm:grid-cols-2" : "";
const gridWidth = cols >= 3 ? "max-w-[1600px]" : cols === 2 ? "max-w-[980px]" : "max-w-[560px]";
---

<section id="words" class="relative bg-[var(--color-bg-base)]">
  <div
    class={`relative mx-auto ${gridWidth} px-4 pt-12 pb-20 md:px-12 md:pt-16 md:pb-32`}
    data-reveal
  >
    <div class={`grid grid-cols-1 gap-6 ${gridCols}`}>
      {
        items.map((it) => (
          <figure
            class="testimonial group m-0 flex min-h-[360px] flex-col justify-between gap-10 rounded-[22px] p-8 md:p-9"
            data-reveal-child
          >
            {/* Solid double-quote glyph — the signature mark, in brand rose */}
            <svg
              class="testimonial__mark"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
            </svg>

            <div class="flex flex-col gap-8">
              <blockquote
                class="m-0 font-sans font-normal text-[var(--color-fg-primary)]"
                style="font-size: clamp(15px, 1.1vw, 17px); line-height: 1.6; letter-spacing: -0.005em;"
              >
                {quoteOf(it, locale)}
              </blockquote>

              <figcaption class="flex items-center gap-3.5">
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-[12px] font-medium"
                  style="background: var(--color-rose-subtle); color: var(--color-rose-tint); letter-spacing: 0.04em;"
                >
                  {initialsOf(it.name)}
                </div>
                <div>
                  <div class="text-[14px] font-semibold text-[var(--color-fg-primary)]">
                    {it.name}
                  </div>
                  <div class="mt-0.5 text-[13px] text-[var(--color-fg-secondary)]">
                    {it.role ? `${it.role}, ${it.company}` : it.company}
                  </div>
                </div>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Testimonial card ──────────────────────────────────────────────
     Flat elevated surface, soft floating shadow, generously rounded —
     matching the reference. Solid rose quote glyph anchors the top, a
     deliberate gap of breathing room, then quote and person at the base
     (justify-between aligns mark and footer regardless of quote length).
     Background lives ONLY here so it never collides with the scoped rule's
     higher specificity. */
  .testimonial {
    background: var(--color-bg-elevated);
    box-shadow: 0 18px 44px -22px rgba(0, 0, 0, 0.55);
    transition:
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .testimonial:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 60px -24px rgba(0, 0, 0, 0.6);
  }

  /* Solid quote glyph — prominent, in brand rose, lifts slightly on hover */
  .testimonial__mark {
    width: 2.75rem;
    height: auto;
    color: var(--color-rose);
    transition:
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
      color 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .testimonial:hover .testimonial__mark {
    transform: translateY(-2px);
    color: var(--color-rose-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial,
    .testimonial__mark {
      transition: none;
    }
    .testimonial:hover {
      transform: none;
    }
    .testimonial:hover .testimonial__mark {
      transform: none;
    }
  }
</style>
