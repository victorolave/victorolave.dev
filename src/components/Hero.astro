---
// Hero — scroll-driven "split reveal" (inspired by lukebaffait.fr, rebuilt
// in Victor's burgundy/editorial language).
//
// At rest: editorial background + the name "Victor Olave." centered low,
// a poetic descriptor top-left, and a bottom bar (version · socials · nav).
//
// On scroll (desktop, motion allowed): "Victor" slides left, "Olave." slides
// right, and the portrait grows from the gap to a full-bleed image that hands
// off to the statement section below. Driven from src/scripts/motion.ts via
// setupHeroSplit() writing inline styles to [data-hero-*] targets.

import Grainient from "./Grainient.astro";
import { t } from "../i18n";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const githubSvg = `<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`;
const linkedinSvg = `<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`;
const mailSvg = `<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="2"/><path d="m3 6.5 9 6.5 9-6.5"/></svg>`;

const socials = [
  { label: "GitHub", href: "https://github.com/victorolave", svg: githubSvg },
  { label: "LinkedIn", href: "https://linkedin.com/in/victorolave", svg: linkedinSvg },
  { label: dict.a11y.email, href: "mailto:hola@victorolave.dev", svg: mailSvg },
];

const navLinks = [
  { label: dict.sections.work, href: "#work" },
  { label: dict.sections.about, href: "#about" },
  { label: dict.sections.contact, href: "#contact" },
];
---

<section
  id="hero"
  class="hero relative h-[180vh] w-full bg-[var(--color-bg-base)] md:h-[230vh]"
>
  <!-- The visible name is two animated spans, so the heading search engines
       read lives here: name, role and place, in plain text. -->
  <h1 class="sr-only">{dict.meta.heroHeading}</h1>

  <div
    class="hero-sticky sticky top-0 flex h-screen w-full items-center justify-center overflow-hidden"
  >
    <!-- Grainient WebGL background (ported to vanilla ogl, on-brand palette) -->
    <div
      data-hero-bg
      aria-hidden="true"
      class="hero-bg pointer-events-none absolute inset-0"
    >
      <Grainient
        class="h-full w-full"
        color1="#D87A99"
        color2="#C04970"
        color3="#14171C"
        timeSpeed={0.16}
        colorBalance={-0.1}
        contrast={1.35}
        saturation={1.05}
        grainAmount={0.08}
        grainScale={2.2}
        warpStrength={1.0}
        warpAmplitude={60}
        rotationAmount={420}
        noiseScale={1.6}
        zoom={1.0}
      />
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background: linear-gradient(180deg, rgba(20,23,28,0.38) 0%, transparent 28%, transparent 68%, rgba(20,23,28,0.6) 100%);"
    >
    </div>

    <!-- Next section (statement) grows from a dot at centre to full-bleed -->
    <div
      data-hero-media
      class="hero-media pointer-events-none absolute inset-0 z-10 flex items-center justify-center overflow-hidden bg-[var(--color-bg-deep)] px-[6vw]"
    >
      <p
        data-hero-statement
        class="hero-statement fraunces text-center font-light leading-[1.04] tracking-[-0.045em] text-[var(--color-fg-primary)]"
        style="font-size: clamp(40px, 5.6vw, 84px); max-width: 980px;"
      >
        {dict.hero.statementPre}
        <span class="fraunces-italic text-[var(--color-rose)]">{dict.hero.statementItalic}</span>{dict.hero.statementPost}
      </p>
    </div>

    <!-- Welcome descriptor (top-left) -->
    <p
      data-hero-desc
      class="hero-desc absolute left-4 top-[92px] z-20 max-w-[360px] leading-[1.4] tracking-[-0.01em] text-[var(--color-fg-primary)] md:left-12 md:top-[132px] md:max-w-[480px]"
      style="font-size: clamp(20px, 2vw, 30px);"
    >
      {dict.hero.descPre} <span class="fraunces-italic text-black"
        >{dict.hero.descItalic}</span
      > {dict.hero.descPost}
    </p>

    <!-- Name — inner edges anchored to center; split tracks the image width -->
    <div
      class="hero-names pointer-events-none absolute inset-0 z-20 flex flex-col items-center justify-center gap-1 px-4 text-center md:block md:px-0 md:text-left"
    >
      <span
        data-hero-name-left
        class="hero-name fraunces self-start whitespace-nowrap font-light leading-[0.82] tracking-[-0.04em] text-[var(--color-fg-primary)] md:self-auto md:absolute md:right-1/2 md:top-1/2"
      >
        Victor
      </span>
      <span
        data-hero-name-right
        class="hero-name fraunces self-end whitespace-nowrap font-light leading-[0.82] tracking-[-0.04em] text-[var(--color-fg-primary)] md:self-auto md:absolute md:left-1/2 md:top-1/2"
      >
        Olave<span class="text-[var(--color-rose)]">.</span>
      </span>
    </div>

    <!-- Bottom bar -->
    <div
      data-hero-bar
      class="hero-bar absolute inset-x-0 bottom-0 z-30 flex items-center justify-between gap-4 border-t border-[var(--color-border)] px-4 py-4 font-mono text-[13px] uppercase tracking-[0.18em] text-[var(--color-fg-primary)] md:px-12 md:py-5"
    >
      <span class="hidden md:inline text-[var(--color-fg-secondary)]">→ V1.0</span>

      <div class="flex items-center gap-4">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
              data-cursor={dict.cursor.view}
              aria-label={s.label}
              class="inline-flex h-11 w-11 items-center justify-center -m-1 text-[var(--color-fg-primary)] transition-colors duration-200 hover:text-[var(--color-rose)]"
              set:html={s.svg}
            />
          ))
        }
      </div>

      <div class="flex items-center gap-4">
        {
          navLinks.map((l, i) => (
            <>
              {i > 0 && (
                <span class="text-[var(--color-fg-quaternary)]" aria-hidden="true">
                  /
                </span>
              )}
              <a
                href={l.href}
                class="inline-flex items-center py-2.5 -my-2.5 font-medium transition-colors duration-200 hover:text-[var(--color-rose)]"
              >
                {l.label}
              </a>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Luminous rose serif — Victor's answer to Luke's teal gradient. */
  .hero-serif-gradient {
    background: linear-gradient(
      105deg,
      var(--color-rose-tint) 0%,
      var(--color-rose-soft) 42%,
      var(--color-rose) 88%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Opacity is driven by the scroll (recedes as the statement grows). */
  .hero-bg {
    opacity: 0.95;
  }

  /* Reveal panel covers the viewport; the SHAPE is driven by clip-path
     (circle → rounded square → full rectangle), so the circle is perfectly
     round on any aspect ratio and the end is always a clean full rectangle.
     The statement text scales separately for the "grows from a dot" feel. */
  .hero-media {
    clip-path: circle(0px at 50% 50%);
    opacity: 0;
    will-change: clip-path, opacity;
  }
  .hero-statement {
    transform: scale(0.55);
    transform-origin: center;
    will-change: transform;
  }

  .hero-name {
    will-change: transform;
    /* Mobile fallback shown before / without the JS auto-fit (setupHeroNameFit
       in motion.ts measures the word and overrides this to fill the width). */
    font-size: clamp(88px, 26vw, 130px);
  }

  /* When the scroll transition can't run (reduced motion, or no JS) there is
     nothing to pin — collapse the hero to a single viewport so the extra
     scroll runway doesn't turn into dead empty scroll. (.js is set in <head>
     before paint, so html:not(.js) only matches a genuine no-JS load.) */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100vh;
    }
  }
  html:not(.js) .hero {
    height: 100vh;
  }

  /* Desktop static fallback (no-JS / reduced-motion): names sit lower-centre,
     apart. The scroll driver overrides these inline when it runs. */
  @media (min-width: 768px) {
    .hero-name {
      font-size: clamp(80px, 15vw, 280px);
    }
    .hero-names [data-hero-name-left] {
      transform: translate(-72px, calc(-50% + 150px));
    }
    .hero-names [data-hero-name-right] {
      transform: translate(72px, calc(-50% + 150px));
    }
  }

  /* Intro fade-in (opacity only — transform is reserved for the scroll split). */
  html.js .hero-desc,
  html.js .hero-name,
  html.js .hero-bar {
    animation: hero-fade-in 1.1s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      both;
  }
  html.js .hero-name {
    animation-delay: 0.12s;
  }
  html.js .hero-bar {
    animation-delay: 0.28s;
  }

  @keyframes hero-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .hero-desc,
    html.js .hero-name,
    html.js .hero-bar {
      animation: none;
    }
  }
</style>
