---
// Visible link to the counterpart locale, present on every page. No
// data-nav-link (the Nav scroll-spy would fight over it), no data-cursor or
// data-magnetic (it gets the generic 56px cursor ring), no "#" href (Lenis
// ignores those).
import { t } from "../i18n";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const linkClass = (active: boolean) =>
  `flex h-11 min-w-11 items-center justify-center font-mono text-[11px] uppercase transition-colors duration-200 ${
    active
      ? "text-[var(--color-fg-primary)]"
      : "text-[var(--color-fg-tertiary)] hover:text-[var(--color-fg-primary)]"
  }`;
---

<nav aria-label={dict.a11y.language} class="flex items-center gap-1.5">
  <a
    href="/"
    hreflang="es"
    lang="es"
    aria-current={locale === "es" ? "page" : undefined}
    class={linkClass(locale === "es")}
    style="letter-spacing: 0.18em;"
  >
    ES<span class="sr-only"> · Español</span>
  </a>
  <span aria-hidden="true" class="text-[var(--color-fg-quaternary)]">/</span>
  <a
    href="/en/"
    hreflang="en"
    lang="en"
    aria-current={locale === "en" ? "page" : undefined}
    class={linkClass(locale === "en")}
    style="letter-spacing: 0.18em;"
  >
    EN<span class="sr-only"> · English</span>
  </a>
</nav>
