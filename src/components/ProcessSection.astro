---
const steps = [
  { n: "01", title: "Listen", desc: "Map the territory before drawing the map." },
  { n: "02", title: "Frame", desc: "One user, one outcome, one week of work." },
  { n: "03", title: "Build", desc: "Ship small and pointed. Deploy day one." },
  { n: "04", title: "Refine", desc: "Harden the seams, document, hand off clean." },
];
---

<section
  id="process"
  class="relative bg-[var(--color-bg-deep)]"
>
  <div
    class="relative mx-auto max-w-[1600px] px-4 pt-12 pb-16 md:px-12 md:pt-16 md:pb-32"
    data-reveal
  >
    <div class="grid grid-cols-1 gap-x-20 gap-y-16 md:grid-cols-2 md:gap-y-24">
      {
        steps.map((s, i) => (
          <div
            class="process-card group relative flex flex-col gap-5 overflow-hidden border-t border-[var(--color-border)] pt-8 transition-colors duration-300 hover:border-[var(--color-rose)] md:pt-12"
            data-reveal-child
          >
            <span class="process-rule" data-process-rule aria-hidden="true" />
            <span
              class="font-mono text-[10px] uppercase text-[var(--color-fg-tertiary)]"
              style="letter-spacing: 0.22em;"
            >
              Step {i + 1} / 4
            </span>

            <div class="flex items-baseline gap-6">
              <span
                class="fraunces-italic font-light leading-none text-[var(--color-rose)]"
                style="font-size: clamp(88px, 9vw, 148px); letter-spacing: -0.05em;"
              >
                {s.n}
              </span>
              <h3
                class="fraunces font-light leading-[0.95] tracking-[-0.03em] text-[var(--color-fg-primary)] transition-colors duration-300 group-hover:text-[var(--color-rose)]"
                style="font-size: clamp(40px, 5vw, 72px);"
              >
                {s.title}
                <em class="fraunces-italic text-[var(--color-rose)]">.</em>
              </h3>
            </div>

            <p
              class="max-w-[420px] text-[16px] leading-[1.6] text-[var(--color-fg-secondary)]"
            >
              {s.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Blueprint rule — a rose line that draws across the card's top edge
     (scaleX from the left) as the card enters, ruled like a draftsman's
     sheet. The real border-t underneath is the no-JS / reduced-motion
     baseline; setupBlueprintRules drives this overlay. */
  .process-rule {
    position: absolute;
    top: -1px;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--color-rose);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }
</style>
